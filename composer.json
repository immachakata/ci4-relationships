{
    "name": "immachakata/ci4-relationships",
    "description": "Easily add and manage database relationships in CodeIgniter 4",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "IsaacMachakata\\Ci4Relationships\\": "src/",
            "CI4Extensions\\Database\\": "src/Legacy/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Isaac Machakata",
            "email": "hie@isaac.co.zw"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^7.4 || ^8.0",
        "codeigniter4/framework": "^4.0"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5"
    },
    "scripts": {
        "test": "phpunit"
    }
}
